  "cdn_image_transform_rules": {
    "canonical_full_resolution": "https://cdn.shopify.com/s/files/1/0251/8217/5331/{path}?v={v}",
    "storefront_variant": "https://vixenbrand.com/cdn/shop/{path}_{width}x{height}.{jpg|png|webp}?v={v}",
    "observed_width_ladder": [200, 400, 410, 600, 800, 1000, 1200, 1400, 1600, 1800, 2000, 2500, 3000, 3500, 4000, 4500, 5000],
    "supported_params": {
      "width": "crop/resize to a pixel width, e.g. _800x",
      "height": "e.g. _800x1200",
      "crop": "center | top | bottom | left | right, e.g. _800x800_crop_center",
      "format": "jpg | png | webp | avif - append .webp to any path to force a format",
      "quality": "1-100, e.g. &quality=75",
      "v": "cache-busting upload timestamp (unix seconds)"
    },
    "important": "Shopify generates these variants on demand and caches them at the edge. The set of 'available' CDN resources is therefore effectively unbounded: any width/height/format combination of any uploaded file is a valid, live URL. The 17-width ladder above is what the Turbo theme actually requests; the underlying uploads are the canonical cdn.shopify.com URLs."
